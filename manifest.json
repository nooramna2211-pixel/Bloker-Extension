{
  "manifest_version": 3,
  "name": "Bloker Content Filter",
  "version": "1.0.1",
  "description": "Blocks configured search terms on browsers.",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "filter_terms.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}